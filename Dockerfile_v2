# ----- Stage 1: builder -----
FROM maven:3.9-eclipse-temurin-21 AS builder
WORKDIR /app
COPY . .
RUN mvn clean package -DskipTests

# ----- Stage 2: runtime -----
# alpine sta per un'app 'minimale'
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
# comando per creare un utente (in realta' un gruppo, al quale poi assegno l'utente)
RUN addgroup -S app && adduser -S pippo -G app
COPY --from=builder /app/target/devops-app-0.0.1-SNAPSHOT.jar app.jar
# Espone la porta
EXPOSE 8080
# da qui in poi l'utente cambia con quello specificato
USER pippo
# comando per eseguire l'applicazione
cmd ["java", "-jar", "app.jar"]




##### in queste 2 fasi si utilizza la multi-stage build: serve ad abbattere il peso dell'immagine Docker ####